{
    "compilerOptions": {
        "outDir": "./dist",
        "target": "ES6",
        "module": "ESNext",
        "lib": ["ES2020", "DOM"],
        "moduleResolution": "node",
        "declaration": true,
        "strict": true,
        "esModuleInterop": true,
        "noUncheckedIndexedAccess": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
}
